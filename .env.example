NODE_ENV=development
PORT=4000

DB_HOST=localhost
# XAMPP/MariaDB commonly runs on 3307 when 3306 is already claimed.
DB_PORT=3306
DB_USER=launchpad
DB_PASSWORD=strong_password_here
DB_NAME=launchpad
DB_POOL_LIMIT=5

# All three must be at least 32 characters and must differ from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_min_32_characters_long_xxxxxxxx
JWT_REFRESH_SECRET=change_me_min_32_characters_long_yyyyyyyy
JWT_STEP_SECRET=change_me_min_32_characters_long_zzzzzzzz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Mixed into the SHA-256 of every one-time code before storage, so a leaked
# database dump alone can't be brute-forced back into valid codes.
OTP_PEPPER=change_me_min_16_chars

# First admin account. Created automatically on boot, but only while no admin
# exists — once one does, these are ignored, so changing the password here will
# not reset a live admin's password. Minimum 12 characters. Leave blank to skip.
SEED_ADMIN_EMAIL=admin@launchpad.dev
SEED_ADMIN_PASSWORD=change_this_admin_password

# Brevo transactional email (https://app.brevo.com/settings/keys/api).
# Leave blank in development and codes are written to the server log instead.
BREVO_API_KEY=
EMAIL_FROM=noreply@launchpad.dev
EMAIL_FROM_NAME=LaunchPad

# IGMS public waitlist (the menospace.uk marketing site). These emails are
# branded separately from every LaunchPad template — recipients are members of
# the public who have never heard of LaunchPad.
IGMS_EMAIL_FROM_NAME=IGMS
# Leave blank to send as EMAIL_FROM. Only set this once the IGMS domain is
# verified in Brevo, or deliverability will quietly collapse.
IGMS_EMAIL_FROM=
# Receives every new-signup notification with the full waitlist attached as a
# CSV. Leave blank to disable the notification (entries are still saved).
# This mailbox will accumulate personal data, including access requirements —
# restrict who can read it and clear it down regularly.
IGMS_ADMIN_EMAIL=
IGMS_SITE_URL=https://menospace.uk
# Optional hosted logo for the email header; falls back to a text lockup.
IGMS_LOGO_URL=

# AI features — CV assist, the Vocational & HR Buddy chat, and CV export
# (export itself needs no key, only the two "improve with AI" / chat calls
# do). Each provider is independent: leave a key blank to disable just that
# option in the pathway's provider toggle. At least one should be set for
# the AI features to do anything.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed for CORS besides FRONTEND_URL
CORS_EXTRA_ORIGINS=

# strict | lax | none. Use "none" only if the app and API sit on different
# registrable domains in production (requires HTTPS on both).
COOKIE_SAMESITE=strict
# Leave blank unless you need the refresh cookie shared across subdomains.
COOKIE_DOMAIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

SWAGGER_ENABLED=true
